# ==============================================================================
# Telegram Personal AI Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot (REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Bot API token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of numeric Telegram User IDs allowed to access the assistant.
# Get your numeric ID from @userinfobot or @raw_data_bot.
# Default-deny: Any user ID not listed here will be rejected immediately.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 2. Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension.
# Example for Railway managed PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/railway
# Example for local development with Docker:
DATABASE_URL=postgresql+asyncpg://assistant:secretpassword123@localhost:5432/personal_assistant
# Fallback for local testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///storage/agent.db

# ------------------------------------------------------------------------------
# 3. OpenRouter LLM Gateway (REQUIRED)
# ------------------------------------------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model: Verified OpenRouter identifier for OpenAI GPT-OSS 120B
# Pricing: Check current openrouter.ai/models conditions.
OPENROUTER_MODEL=openai/gpt-oss-120b

# Fallback model when primary experiences rate-limits, outages, or unavailability:
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=https://github.com/personal-ai-assistant
OPENROUTER_APP_NAME=Personal AI Assistant

# ------------------------------------------------------------------------------
# 4. Cryptography & OAuth Token Encryption (REQUIRED)
# ------------------------------------------------------------------------------
# URL-safe base64-encoded 32-byte key for AES-Fernet encryption of stored OAuth tokens.
# Generate in python with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=w_9w12M7O5E-8d_f1JzB4pA6kL3sV9tX2qY5mZ7nK1o=

# ------------------------------------------------------------------------------
# 5. Search & Research Providers (At least one recommended)
# ------------------------------------------------------------------------------
# Perplexity API: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PERPLEXITY_MODEL=sonar

# Google Custom Search API: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Tavily Search API: https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. Google / Gmail OAuth 2.0 (Optional - for Gmail reading & drafting)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Must match the Authorized Redirect URI in Google Cloud Console:
GOOGLE_REDIRECT_URI=https://your-app.railway.app/oauth/google/callback

# ------------------------------------------------------------------------------
# 7. Embeddings, Vision & Transcription
# ------------------------------------------------------------------------------
# Embeddings: 'local' (deterministic fallback) or 'openrouter' / 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Audio transcription: 'openrouter', 'groq', 'openai', or 'none'
TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_API_KEY=

# Vision processing model on OpenRouter
VISION_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 8. Operational Settings & Budgets
# ------------------------------------------------------------------------------
APP_ENV=production
APP_TIMEZONE=Africa/Lagos
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=20
MAX_TOOL_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=60.0

# Cost control: Daily and Monthly USD budgets
DAILY_MODEL_BUDGET=5.0
MONTHLY_MODEL_BUDGET=50.0

# Server Binding
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=./storage
